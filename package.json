{
  "name": "ekitan-trainno-display",
  "version": "0.1.0",
  "description": "Add the display of the train number to the train timetable.",
  "main": "index.js",
  "scripts": {
    "watch:src": "webpack --config webpack/webpack.dev.js --watch",
    "watch:dist": "mv3-hot-reload",
    "start": "npm-run-all --parallel watch:*",
    "build": "webpack --config webpack/webpack.prod.js",
    "test": "jest",
    "lint": "eslint src",
    "clean": "rimraf dist",
    "bumpup": "bash ./scripts/bumpup.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoisupersix/ekitan-trainno.git"
  },
  "author": "aoisupersix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aoisupersix/ekitan-trainno/issues"
  },
  "homepage": "https://github.com/aoisupersix/ekitan-trainno#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.8",
    "@types/jest": "^30.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mv3-hot-reload": "^0.2.7",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
